SELECT with Alias
--------------------------------------------------------------------

-1. Display f_name as First Name.
    select f_name as [First Name] from cust
 
- 2.Display l_name as Last Name.
     select l_name as [Last Name] from cust

- 3.Display salary as Employee Salary.
     select salary as [Employee Salary] from cust

- 4.Display department as Dept.
    select department as Dept from cust

- 5.Display city as Location.
   select city as location from cust

- 6.Display both f_name and l_name using aliases.
   select f_name as [first_name],l_name as [last name] from cust

- 7Display joining_date as Date of Joining.
   select joining_date as [date of joining] from cust

- 8.Display cid as Customer ID.
   select cid as [cust id] from cust

- 9.Display email as Email Address.
   select email as Email from cust

- 10.Display age as Customer Age.
   select age as cust_age from cust


SELECT with Expressions
----------------------------------------------------------------------------

- 1.Display the salary increased by 5000.
   select salary,salary+5000 as [incresed sal] from cust

- 2.Display the salary increased by 10%.
    select salary+(salary*0.10)as incresed_sal from cust

- 3.Display the annual salary (salary × 12).
    select salary,salary*12 as annaual_sal from cust

- 4.Display age after adding 5 years.
   select age,age+5 from cust

- 5.Display salary minus 2000.
   select salary,salary-2000 from cust

- 6.Display salary multiplied by 2.
   select salary,salary*2 from cust

- 7.Display half of the salary.
   select salary,salary/2 from cust

- 8.Display age multiplied by 2.
   select age,age*2 from cust

- 9.Display salary + bonus (bonus = 10000).
    select salary,salary+10000 from cust

- 10.Display salary after deducting 5%.
    select salary-(salary*0.05) from cust


