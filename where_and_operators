 -- LIKE OPERATOR
 --use like operator for pattren comaprision

-1.Display customers whose first name starts with 'A'.
  select*from cust where f_name like 'A%'

-2.Display customers whose first name ends with 'a'.
  select*from cust where f_name like '%a'

-3.Display customers whose first name contains 'an'.
  select*from cust where f_name like 'an%'

-4.Display customers whose city starts with 'H'.
  select*from cust where city like'h%'

-5.Display customers whose city ends with 'i'.
   select*from cust where city like '%i'

-6.Display customers whose department starts with 'S'.
