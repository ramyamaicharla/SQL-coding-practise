CREATE TABLE cust
(
    cid INT PRIMARY KEY,
    f_name VARCHAR(30),
    l_name VARCHAR(30),
    age INT,
    gender VARCHAR(10),
    city VARCHAR(30),
    salary DECIMAL(10,2),
    department VARCHAR(30),
    joining_date DATE,
    email VARCHAR(50)
);


