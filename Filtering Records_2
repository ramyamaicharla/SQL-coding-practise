--COMPOUND CONDITIONS
-- AND / OR / NOT (20 Questions)
-- multiple conditions combined with AND/OR operators called Compound conditions
--AND=both conditons are true
--OR= only one condition or both conditions are true.

- 1.Display customers whose age is greater than 25 AND salary is greater than 50000.
   select*from cust where age>25 and salary>50000

-2.Display customers from Hyderabad AND IT department.
  select*from cust where city='Hyderabad' and department='it'

-3.Display customers whose age is less than 30 AND gender is Female.
  select*from cust where age<30 and gender='female'

-4.Display customers whose salary is greater than 40000 AND city is Chennai.
   select*from cust where salary>40000 and city='Chennai'

-5.Display customers whose department is HR AND salary is less than 60000.
