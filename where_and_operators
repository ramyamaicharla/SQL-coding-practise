-7.Display customers whose last name contains 'ra'.
   select*from cust where l_name like '%ra'

-8.Display customers whose email ends with '.com'.
   select*from cust where email like '%.com'

-9.Display customers whose email starts with 'r'.
   select*from cust where email not like '%r'

